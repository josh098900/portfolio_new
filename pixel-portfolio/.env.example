# Copy to .env.local and fill in. Server-side only: never add a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional: an ElevenLabs voice ID (defaults to the premade voice "Alice").
ELEVENLABS_VOICE_ID=
# Upstash Redis for rate limits, provided by the Vercel integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: raises GitHub's rate limit for the Activity app (no scopes needed).
GITHUB_TOKEN=
